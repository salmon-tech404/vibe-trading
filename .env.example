# ============================================================================
# Vibe-Trading - Environment Configuration Template
# Copy this file to .env or agent/.env and configure your keys
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Primary LLM Provider Configuration (Choose ONE provider)
# ----------------------------------------------------------------------------

# Option A: OpenRouter (Recommended: access to DeepSeek, Claude, GPT, etc.)
LANGCHAIN_PROVIDER=openrouter
LANGCHAIN_MODEL_NAME=deepseek/deepseek-v4-pro
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Option B: OpenAI
# LANGCHAIN_PROVIDER=openai
# LANGCHAIN_MODEL_NAME=gpt-4o
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1

# Option C: Anthropic Claude
# LANGCHAIN_PROVIDER=anthropic
# LANGCHAIN_MODEL_NAME=claude-3-7-sonnet-20250219
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Option D: DeepSeek Direct
# LANGCHAIN_PROVIDER=deepseek
# LANGCHAIN_MODEL_NAME=deepseek-chat
# DEEPSEEK_API_KEY=sk-your-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Option E: Google Gemini
# LANGCHAIN_PROVIDER=gemini
# LANGCHAIN_MODEL_NAME=gemini-2.5-flash
# GEMINI_API_KEY=your-gemini-key

# Option F: Ollama (Local LLM)
# LANGCHAIN_PROVIDER=ollama
# LANGCHAIN_MODEL_NAME=llama3.3:latest
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ----------------------------------------------------------------------------
# 2. Server & Runtime Settings
# ----------------------------------------------------------------------------
VIBE_TRADING_PORT=8000
VIBE_TRADING_HOST=127.0.0.1
# VIBE_TRADING_HOME=~/.vibe-trading
# VIBE_TRADING_LLM_TIMEOUT_SECONDS=300

# ----------------------------------------------------------------------------
# 3. Market Data Providers (Optional / As Needed)
# ----------------------------------------------------------------------------
# Tushare (China A-Shares): https://tushare.pro/
# TUSHARE_TOKEN=your_token_here

# Financial Modeling Prep (FMP)
# FMP_API_KEY=your_key_here

# Alpha Vantage
# ALPHAVANTAGE_API_KEY=your_key_here

# CoinGecko / Crypto
# COINGECKO_API_KEY=your_key_here

# ----------------------------------------------------------------------------
# 4. Broker Credentials (Live / Paper Trading)
# ----------------------------------------------------------------------------
# Binance
# BINANCE_API_KEY=your_binance_key
# BINANCE_SECRET=your_binance_secret

# OKX
# OKX_API_KEY=your_okx_key
# OKX_SECRET=your_okx_secret
# OKX_PASSPHRASE=your_okx_passphrase

# Interactive Brokers (IBKR)
# IB_HOST=127.0.0.1
# IB_PORT=7497
# IB_CLIENT_ID=1
