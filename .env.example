# ============================================================================
# Vibe-Trading - Environment Configuration
# ============================================================================

# 1. Google Gemini Provider (Tùy chọn SIÊU RẺ / CÓ GÓI FREE 0 ĐỒNG)
# Lấy key tại: https://aistudio.google.com/
GEMINI_API_KEY="your_google_gemini_api_key_here"
GEMINI_MODEL_NAME=gemini-3.5-flash-lite

# 2. DeepSeek Provider (Tùy chọn Rẻ & Thông minh)
# Lấy key tại: https://platform.deepseek.com/
DEEPSEEK_API_KEY="your_deepseek_api_key_here"
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LANGCHAIN_MODEL_NAME=deepseek-chat

# 3. Telegram Bot Configuration
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_BOT_USERNAME=velx_trading_bot
TELEGRAM_ALLOWED_USERS=1634846878

# 4. Server & Runtime Settings
VIBE_TRADING_PORT=8000
VIBE_TRADING_HOST=127.0.0.1

# 5. Binance API (Demo)
BINANCE_API_KEY="your_binance_api_key_here"
BINANCE_SECRET_KEY="your_binance_secret_key_here"